{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/.verify",
      "!**/test-results",
      "!docs/design/art"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "error" },
      "style": { "noNonNullAssertion": "off" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      "includes": ["src/server/**", "src/shared/**", "fixtures/**"],
      "plugins": ["./biome-plugins/no-math-random.grit"]
    },
    {
      "includes": [
        "src/server/features/**",
        "src/server/commands/**",
        "!src/server/commands/context.ts",
        "!**/*.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Date": "Commands get time only from ctx.clock (AGENTS §9.3).",
                  "crypto": "Commands get IDs and tokens only from ctx.ids / ctx.tokens (AGENTS §9.3)."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/client/common/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@dm/*", "@player/*"],
                    "message": "@ui must not import a client (AGENTS §9.1)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/client/dm/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@player/*"],
                    "message": "DM and player clients must not import each other."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/client/player/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@dm/*"],
                    "message": "DM and player clients must not import each other."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@server/*", "@ui/*", "@dm/*", "@player/*", "@fixtures/*"],
                    "message": "@shared may import zod only (AGENTS §9.1)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
