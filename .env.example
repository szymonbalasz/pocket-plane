# Copy is written by `bun run env:init` (AGENTS §9.2). Never commit `.env`.

# Worktree port slot, 0-49. base port = 4100 + 10 * PP_SLOT.
PP_SLOT=
# dev | verify (also --profile <name> on commands)
# PP_PROFILE=dev
# PP_HOST=127.0.0.1
# Explicit ports override the slot (0 = OS-assigned)
# PP_PORT=
# PP_VITE_PORT=
# Runtime data root; relative paths resolve from the worktree root
# PP_DATA_DIR=data/dev
# PP_DB_PATH=
# PP_ASSET_DIR=
# 1 = this data dir may be wiped and seeded. Never set on a real install.
PP_DATA_DISPOSABLE=
# 1 = test-only records and routes (sync probe). Requires PP_DATA_DISPOSABLE=1.
# PP_TEST_MODE=
# PP_TEST_CRASH=   # test-only crash hook (needs PP_TEST_MODE=1 + PP_DATA_DISPOSABLE=1), e.g. cbt.applyCard:after-commit (#163)
# DM secret, min 12 chars. Env only, never stored.
PP_DM_SECRET=
# Base for player links, e.g. the cloudflared tunnel URL
# PP_PUBLIC_BASE_URL=
# debug | info | warn | error
# PP_LOG_LEVEL=info

# Real campaigns: `bun run play` (#382). Live data outside the checkout, not in a synced
# folder (OneDrive etc.). Default: Windows %LOCALAPPDATA%/PocketPlane, macOS
# ~/Library/Application Support/PocketPlane, else $XDG_DATA_HOME/pocket-plane or
# ~/.local/share/pocket-plane. Refused inside the checkout or the OS temp dir.
# PP_PLAY_DATA_DIR=
# Start-up backups (DB copies, newest 10, + assets mirror); default <play dir>/backups. May be a synced folder.
# PP_PLAY_BACKUP_DIR=
# Port for `bun run play`; default 4090 (outside the slot range 4100-4599)
# PP_PLAY_PORT=4090
